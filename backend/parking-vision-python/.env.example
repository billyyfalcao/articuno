# JSON array of exact browser origins; no wildcard, path or credentials.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional absolute directory containing only authorized local MP4 samples.
# VIDEO_ROOT=C:/parking-videos
# Optional absolute path to a CameraMap JSON. Default: cameras.example.json (demo).
# CAMERA_CONFIG=C:/parking-config/cameras.json

# HTTP delivery is disabled unless BOTH origin and path are explicitly supplied.
# These paths are a LOCAL MOCK example, NOT a confirmed Java contract.
# JAVA_API_BASE_URL=http://127.0.0.1:9001
# JAVA_EVENTS_ENDPOINT=/mock/ok
# INTERNAL_API_KEY=local-mock-only
JAVA_TIMEOUT=3
JAVA_MAX_RETRIES=2
JAVA_RETRY_DELAY=0.2
# Enable only when the receiving server guarantees idempotency for event_id.
JAVA_IDEMPOTENCY_CONFIRMED=false
