# Server variables only. Do not add the VITE_ prefix to secrets.
FRONTEND_PORT=5173
PYTHON_API_BASE_URL=http://127.0.0.1:8000
JAVA_API_BASE_URL=http://127.0.0.1:8080
INTERNAL_API_KEY=
